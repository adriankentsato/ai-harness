{
  "name": "ai-harness",
  "version": "1.0.0",
  "type": "module",
  "description": "Unified AI harness for OpenAI, Claude, Google AI, NVIDIA NIM, OpenRouter, and Ollama",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
