    "@ai-sdk/provider": "^2.0.0",
    "ai": "^5.0.0",
    "ai-v1": "npm:ai@^4.0.0",
    "better-sqlite3": "^12.9.0",
    "ollama": "^0.5.18",
    "ollama-ai-provider": "^1.2.0",
    "openai": "^4.104.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
